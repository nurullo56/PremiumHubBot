# ============================================
# BOT SETTINGS
# ============================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=your_bot_username
ADMIN_ID=123456789

# ============================================
# DATABASE
# ============================================
DATABASE_PATH=bot/database.db

# ============================================
# REFERRAL SETTINGS
# ============================================
REQUIRED_REFERRALS=40
REFERRAL_BONUS=1.4
PREMIUM_COST=56
PREMIUM_DURATION_DAYS=30

# ============================================
# SECURITY
# ============================================
CAPTCHA_EXPIRY_MINUTES=3

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# WEBHOOK (polling uchun bu qatorlar kerak emas)
# ============================================
# USE_WEBHOOK=true
# WEBHOOK_HOST=https://yourdomain.com   # https bilan, oxirida / bo'lmasdan
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080

# ============================================
# OPTIONAL: ERROR TRACKING
# ============================================
# SENTRY_DSN=your_sentry_dsn_here

# ============================================
# OPTIONAL: TELEGRAM PREMIUM FILE
# ============================================
# PREMIUM_FILE_ID=your_premium_photo_file_id
